# Port for the API + realtime server
PORT=4000

# Secret used to sign login tokens. Change this to a long random string.
JWT_SECRET=change-me-to-a-long-random-string

# Where the SQLite database lives (created automatically)
DATABASE_FILE=./data/mindlink.db

# Allowed browser origin(s) for CORS, comma separated
CLIENT_ORIGIN=http://localhost:5173

# Optional: enables AI features (checkpoint messages, Pair assistant, catch-up summaries) via Gemini.
# Get a free key at https://aistudio.google.com/apikey — without it, MindLink uses built-in heuristics.
GEMINI_API_KEY=
# Optional: which Gemini model to use (defaults to the latest Flash model, which the free tier covers).
GEMINI_MODEL=gemini-flash-latest

# Optional: a self-hosted Piston instance (https://github.com/engineer-man/piston)
# to run languages the browser can't (Java, C++, Go, Rust, ...).
# JavaScript, TypeScript, Python and HTML always run in the browser.
PISTON_URL=
